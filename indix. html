<script>
(function(){
  const form=document.getElementById('bookingForm');
  const passengerFields=document.getElementById('passengerFields');
  const cargoFields=document.getElementById('cargoFields');
  const status=document.getElementById('formStatus');
  const passengerInputs=[...passengerFields.querySelectorAll('input,select,textarea')];
  const cargoInputs=[...cargoFields.querySelectorAll('input,select,textarea')];
  function updateType(){
    const type=form.querySelector('input[name="requestType"]:checked').value;
    const showPassenger=type==='passenger'||type==='both';
    const showCargo=type==='cargo'||type==='both';
    passengerFields.hidden=!showPassenger; cargoFields.hidden=!showCargo;
    passengerInputs.forEach(el=>{el.required=showPassenger&&(el.id==='origin'||el.id==='destination'||el.id==='travelDate');});
    cargoInputs.forEach(el=>{el.required=showCargo&&(el.id==='cargoType'||el.id==='cargoWeight'||el.id==='cargoOrigin'||el.id==='cargoDestination');});
    status.style.display='none';
  }
  form.querySelectorAll('input[name="requestType"]').forEach(el=>el.addEventListener('change',updateType));
  document.querySelectorAll('[data-select-type]').forEach(link=>link.addEventListener('click',()=>{
    const wanted=link.getAttribute('data-select-type');
    const radio=form.querySelector('input[name="requestType"][value="'+wanted+'"]');
    if(radio){radio.checked=true;updateType();}
  }));
  updateType();
  form.addEventListener('submit',function(event){
    event.preventDefault();
    if(!form.reportValidity()) return;
    const d=new FormData(form); const type=d.get('requestType');
    const typeNames={passenger:'رزرو مسافر',cargo:'درخواست باربری',both:'رزرو مسافر و باربری'};
    const lines=['سلام، از طریق سایت حسنی ترانسپورت درخواست دارم.','نوع درخواست: '+typeNames[type]];
    if(type==='passenger'||type==='both'){
      lines.push('--- اطلاعات سفر ---','مبدأ سفر: '+d.get('origin'),'مقصد سفر: '+d.get('destination'),'تاریخ حرکت: '+d.get('travelDate'),'ساعت حرکت: '+(d.get('travelTime')||'مشخص نشده'),'تعداد مسافران: '+d.get('passengerCount'));
    }
    if(type==='cargo'||type==='both'){
      lines.push('--- اطلاعات بار ---','نوع بار: '+d.get('cargoType'),'وزن تقریبی: '+d.get('cargoWeight')+' کیلوگرم','مبدأ بار: '+d.get('cargoOrigin'),'مقصد بار: '+d.get('cargoDestination'),'توضیحات بار: '+(d.get('cargoDetails')||'ندارد'));
    }
    lines.push('--- اطلاعات تماس ---','نام: '+d.get('customerName'),'شماره تماس: '+d.get('customerPhone'),'توضیحات اضافی: '+(d.get('extraNotes')||'ندارد'));
    const url='https://wa.me/93780316182?text='+encodeURIComponent(lines.join('\n'));
    status.style.display='block'; status.textContent='واتساپ در حال باز شدن است. اگر باز نشد، دکمه زیر را بزنید.';
    const openLink=document.createElement('a'); openLink.href=url; openLink.target='_blank'; openLink.rel='noopener noreferrer'; openLink.className='btn btn-green'; openLink.style.marginTop='8px'; openLink.textContent='باز کردن واتساپ و ارسال درخواست';
    const old=status.querySelector('a'); if(old) old.remove(); status.appendChild(document.createElement('br')); status.appendChild(openLink);
    const win=window.open(url,'_blank','noopener,noreferrer'); if(!win){openLink.focus();}
  });
  const dateInput=document.getElementById('travelDate');
  const now=new Date(); dateInput.min=new Date(now.getTime()-now.getTimezoneOffset()*60000).toISOString().slice(0,10);
})();
</script>
